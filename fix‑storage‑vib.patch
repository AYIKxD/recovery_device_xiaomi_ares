From 7ea2d45e6f9151e8b09a94dcde1a9f5e4b1adf26 Mon Sep 17 00:00:00 2001
Subject: [PBRP] ares: storage + vibrator + FBE support

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 9b1dee3..6f31368 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@
 ## Recovery flags
+BOARD_USES_METADATA_PARTITION := true
+TW_INCLUDE_CRYPTO             := true
+TW_INCLUDE_FBE                := true
+TW_INCLUDE_FBE_METADATA_DECRYPT := true
+TW_USE_FSCRYPT_POLICY         := 1
+
+# Haptics in PBRP GUI
+TW_SUPPORT_INPUT_AIDL_HAPTICS := true

diff --git a/device.mk b/device.mk
index 3c62f12..ae3a154 100644
--- a/device.mk
+++ b/device.mk
@@
 PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/init.vibrator.rc:$(TARGET_COPY_OUT_RECOVERY)/root/init.vibrator.rc

diff --git a/recovery/root/system/etc/recovery.fstab b/recovery/root/system/etc/recovery.fstab
index 2abbe94..fe16b45 100644
--- a/recovery/root/system/etc/recovery.fstab
+++ b/recovery/root/system/etc/recovery.fstab
@@
-/dev/block/by-name/userdata      /data      ext4    wait,check,formattable,quota
+/dev/block/by-name/userdata      /data      f2fs    wait,check,formattable,quota,flags=display="Internal Storage";wipeingui;storage
@@
-/dev/block/by-name/cache         /cache     ext4    wait,check
+/dev/block/by-name/cache         /cache     ext4    wait,check,flags=backup=1

+# PBRP needs metadata for FBE
+/dev/block/by-name/metadata      /metadata  ext4    wait,formattable

+# Symlink for /sdcard
+mount     /data/media/0   /sdcard      bind    bind

+# Fix cancel‑freeze watchdog (5 s)
+
+service watchdog_update_details /sbin/watchdog_update_details 5000
+    class late_start
+    oneshot

diff --git a/init.vibrator.rc b/init.vibrator.rc
new file mode 100644
--- /dev/null
+++ b/init.vibrator.rc
@@
+on boot
+    # Dimensity 1200 – mt6359 haptics
+    chmod 0660 /dev/mt6359_haptic
+    chown system system /dev/mt6359_haptic
+    symlink /dev/mt6359_haptic /dev/vibrator
+
+on property:vibrator.init=1
+    start vendor.hw.vibrator@1.3-service
